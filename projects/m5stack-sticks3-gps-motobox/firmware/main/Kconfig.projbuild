menu "StickS3 GPS MotoBox Demo"

config DEMO_CELLULAR
    bool "Use ML307R-DL cellular uplink"
    default y

config DEMO_NTP_HOST
    string "Cellular UDP NTP server"
    default "ntp.aliyun.com"

config DEMO_WIFI_SSID
    string "Wi-Fi SSID"
    default ""

config DEMO_WIFI_PASSWORD
    string "Wi-Fi password"
    default ""

config DEMO_MQTT_URI
    string "MotoBox MQTT TLS URI"
    default "wss://emqx.daboluo.cc/mqtt"

config DEMO_MQTT_USERNAME
    string "Device MQTT username"
    default ""

config DEMO_MQTT_PASSWORD
    string "Device MQTT password"
    default ""

config DEMO_PUBLISH_INTERVAL_MS
    int "Telemetry interval (ms)"
    range 1000 60000
    default 5000

endmenu
