  "schemaVersion": 1,
  "documentId": "53dcd402e09040a2",
  "notes": [
    {
      "id": "a4-note-0-0",
      "text": "排针供电 / 模块分工",
      "x": 40,
      "y": 440,
      "fontSize": 16,
      "color": "#333333"
    },
    {
      "id": "a4-note-0-1",
      "text": "适配板不设 Type-C；通过堆叠排针引入 5V / GND。",
      "x": 40,
      "y": 415,
      "fontSize": 12,
      "color": "#333333"
    },
    {
      "id": "a4-note-0-2",
      "text": "当前入口：主机 Type-C → ATOM → STACK_5V。",
      "x": 40,
      "y": 390,
      "fontSize": 12,
      "color": "#333333"
    },
    {
      "id": "a4-note-0-3",
      "text": "J1 为供电逻辑示意；1 = 5V，2 = GND。",
      "x": 40,
      "y": 365,
      "fontSize": 12,
      "color": "#333333"
    },
    {
      "id": "a4-note-0-4",
      "text": "示意针号不等于 ATOM 针号；不导入 PCB / BOM。",
      "x": 40,
      "y": 340,
      "fontSize": 12,
      "color": "#333333"
    },
    {
      "id": "a4-note-0-5",
      "text": "实际配对针位、封装、插入高度与载流待实测。",
      "x": 40,
      "y": 315,
      "fontSize": 12,
      "color": "#333333"
    },
    {
      "id": "a4-note-0-6",
      "text": "独立电源模块后续开发，另定义隔离与电源切换。",
      "x": 40,
      "y": 290,
      "fontSize": 12,
      "color": "#333333"
    },
    {
      "id": "a4-note-0-7",
      "text": "双源暂不并接；Tiny 供电入口和稳压仍待核实。",
      "x": 40,
      "y": 265,
      "fontSize": 12,
      "color": "#333333"
    },
    {
      "id": "a4-note-0-8",
      "text": "ATOM 路径含 1A PTC；4G 峰值带载能力待验证。",
      "x": 40,
      "y": 240,
      "fontSize": 12,
      "color": "#333333"
    },
    {
      "id": "a4-note-1-0",
      "text": "信号与机械约束",
      "x": 625,
      "y": 440,
      "fontSize": 16,
      "color": "#333333"
    },
    {
      "id": "a4-note-1-1",
      "text": "ATOM：G19 → HOST_TX；G22 ← HOST_RX。",
      "x": 625,
      "y": 415,
      "fontSize": 12,
      "color": "#333333"
    },
    {
      "id": "a4-note-1-2",
      "text": "G21 → UART_OE；HOST_3V3 取自主机。",
      "x": 625,
      "y": 390,
      "fontSize": 12,
      "color": "#333333"
    },
    {
      "id": "a4-note-1-3",
      "text": "GNSS 复用 Grove：G26 → RX，G32 ← TX。",
      "x": 625,
      "y": 365,
      "fontSize": 12,
      "color": "#333333"
    },
    {
      "id": "a4-note-1-4",
      "text": "Tiny 标签上→下：BAT / EN / RX / TX / GND / VIN。",
      "x": 625,
      "y": 340,
      "fontSize": 12,
      "color": "#333333"
    },
    {
      "id": "a4-note-1-5",
      "text": "标签观察不是封装针号；VIN / BAT / EN 待核实。",
      "x": 625,
      "y": 315,
      "fontSize": 12,
      "color": "#333333"
    },
    {
      "id": "a4-note-1-6",
      "text": "U2 为条件式；MODEM_VIO_TBD 的电压/来源待定。",
      "x": 625,
      "y": 290,
      "fontSize": 12,
      "color": "#333333"
    },
    {
      "id": "a4-note-1-7",
      "text": "Tiny 实测约 20×20 mm，标称 20×19×6 mm。",
      "x": 625,
      "y": 265,
      "fontSize": 12,
      "color": "#333333"
    },
    {
      "id": "a4-note-1-8",
      "text": "外壳 24×24 mm；保持原排针出口及底壳天线孔。",
      "x": 625,
      "y": 240,
      "fontSize": 12,
      "color": "#333333"
    }
  ]
}
